# FaceScope Environment Configuration
# Path to MediaPipe Face Landmarker model asset
FACESCOPE_MODEL_PATH=models/face_landmarker.task

# Maximum upload size in megabytes
FACESCOPE_MAX_IMAGE_MB=20
FACESCOPE_MAX_VIDEO_MB=100

# Video processing configuration
FACESCOPE_MAX_VIDEO_FRAMES=600
FACESCOPE_MAX_VIDEO_DURATION_SEC=60
FACESCOPE_VIDEO_FRAME_STRIDE=1

# Frontal pose angle thresholds (degrees) for valid symmetry estimation
FACESCOPE_MAX_YAW_DEG=12.0
FACESCOPE_MAX_PITCH_DEG=12.0
FACESCOPE_MAX_ROLL_DEG=12.0
